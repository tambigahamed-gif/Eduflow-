# Paramètres publics du projet Supabase — configurés manuellement dans WebDev/Vercel.
# Ils peuvent être utilisés dans le navigateur; la sécurité dépend des politiques RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Passer à "true" uniquement lorsque Google OAuth est activé et testé dans Supabase.
VITE_SUPABASE_GOOGLE_OAUTH_ENABLED=false
